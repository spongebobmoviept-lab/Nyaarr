# Nyaarr — copy this file to .env (cp .env.example .env). You shouldn't
# need to touch much else in it.
#
# Everything else (Sonarr, Radarr, TMDB, your admin login) is configured
# through the setup wizard in your browser after you start the container:
# http://<this-machine's-ip>:8686
#
# DRY_RUN defaults to true — Nyaarr will log what it *would* grab/remove
# without actually doing it, until you're confident it's picking the right
# releases. Flip it to false once you've reviewed a few Needs Review
# sessions and trust its picks.

DRY_RUN=true

# Optional scan tuning (also editable later in the in-app Settings page):
# Only scan episodes that aired within the last N days; 0 = whole backlog.
# NEW_EPISODES_ONLY_DAYS=7
# Hard-block releases with Opus audio (for players that can't play it).
# BLOCK_OPUS_AUDIO=false
